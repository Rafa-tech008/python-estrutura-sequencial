#EST.DEC_LT01.05
#Declaração de variáveis
a:int=0
b:int=0
c:int=0

#Início
a=int(input("O valor de a:"))
b=int(input("O valor de b:"))
c=int(input("O valor de c:"))
delta=(b**2)-4*a*c
if(delta<0):
    print ("Recomece o cálculo")
else:
    print("Continue o cálculo")
    x1=(-(-b) + (delta**0.5))/2*a
    x2=(-(-b) - (delta**0.5))/2*a
    print ("O valor das raízes são: ", x1,x2)

#Fim
